.menu-root {
    width: 1920px;
    height: 1080px;
    background-color: rgb(23, 25, 28);
    position: relative;
    overflow: hidden;
}

.top-accent {
    width: 100%;
    height: 8px;
    background-color: rgb(59, 111, 224);
}

.menu-content {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
}

.title-block {
    align-items: center;
    margin-bottom: 96px;
}

.game-title {
    font-size: 84px;
    -unity-font-style: bold;
    letter-spacing: 3px;
    color: rgb(242, 242, 242);
    -unity-text-align: middle-center;
}

.title-rule {
    width: 200px;
    height: 3px;
    background-color: rgb(59, 111, 224);
    margin-top: 14px;
}

.game-subtitle {
    font-size: 20px;
    -unity-font-style: bold;
    letter-spacing: 4px;
    color: rgb(120, 125, 130);
    margin-top: 14px;
    -unity-text-align: middle-center;
}

.menu-buttons {
    width: 460px;
}

.menu-button {
    margin-bottom: 24px;
    border-width: 1px;
    border-left-width: 6px;
    border-radius: 0;
    -unity-font-style: bold;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    -unity-text-outline-width: 0;
    background-image: none;
}

.menu-button-primary {
    height: 92px;
    background-color: rgb(32, 34, 38);
    border-color: rgb(59, 111, 224);
    color: rgb(247, 247, 247);
    font-size: 30px;
}

.menu-button-primary:hover {
    background-color: rgb(40, 44, 52);
}

.menu-button-secondary {
    height: 84px;
    background-color: rgb(22, 24, 27);
    border-color: rgb(66, 70, 74);
    color: rgb(191, 194, 196);
    font-size: 24px;
}

.menu-button-secondary:hover {
    background-color: rgb(28, 30, 34);
}

.version-label {
    position: absolute;
    bottom: 28px;
    right: 36px;
    font-size: 18px;
    color: rgb(90, 94, 98);
}
