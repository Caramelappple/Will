  abilities:
  - type: 4
    displayName: "\uC639\uACE8\uCC38"
    description: "\uC4F0\uB7EC\uC9C8 \uB9CC\uD55C \uD53C\uD574\uB97C \uCC98\uC74C \uD55C \uBC88\uB9CC \uBC84\uD2F0\uACE0 \uCCB4\uB825 1\uC774 \uB0A8\uB294\uB2E4. \uAE30\uBB3C\uB9C8\uB2E4 \uD55C \uBC88\uBFD0\uC774\uB2E4."
    icon: {fileID: 0}
  - type: 5
    displayName: "\uB0A0\uB530\uB984"
    description: "\uD53C\uD574\uB97C \uBC1B\uC744 \uB54C 67% \uD655\uB960\uB85C \uC644\uC804\uD788 \uD53C\uD55C\uB2E4. \uD53C\uD558\uBA74 \uD53C\uD574\uAC00 0\uC774 \uB41C\uB2E4."
    icon: {fileID: 0}
  - type: 6
    displayName: "\uD53C\uC758 \uAC08\uC99D"
    description: "\uC801\uC744 \uD558\uB098 \uCC98\uCE58\uD560 \uB54C\uB9C8\uB2E4 \uACF5\uACA9\uB825\uC774 1 \uC624\uB978\uB2E4. \uCD5C\uB300 +3\uAE4C\uC9C0 \uC313\uC778\uB2E4."
    icon: {fileID: 0}
  - type: 7
    displayName: "\uBB34\uB9AC \uC0AC\uB0E5"
    description: "\uB9DE\uB2FF\uC740 \uC5EC\uB35F \uCE78\uC5D0 \uAC19\uC740 \uC885 \uC544\uAD70\uC774 \uC788\uC73C\uBA74 \uD55C \uAE30\uB2F9 \uACF5\uACA9\uB825\uC774 1 \uC624\uB978\uB2E4. \uC6C0\uC9C1\uC774\uBA74 \uAC12\uB3C4 \uB530\uB77C \uBC14\uB010\uB2E4."
    icon: {fileID: 0}
  - type: 8
    displayName: "\uAC00\uC2DC"
    description: "\uADFC\uC811 \uACF5\uACA9\uC744 \uBC1B\uC73C\uBA74 \uB54C\uB9B0 \uCABD\uC5D0 1 \uD53C\uD574\uB97C \uB418\uB3CC\uB9B0\uB2E4. \uC6D0\uAC70\uB9AC\u00B7\uB3C4\uC57D \uACF5\uACA9\uACFC \uC800\uC8FC\uC5D0\uB294 \uBC18\uC751\uD558\uC9C0 \uC54A\uB294\uB2E4."
    icon: {fileID: 0}
  - type: 9
    displayName: "\uBCF5\uC218"
    description: "\uC4F0\uB7EC\uC9C8 \uB54C \uC790\uC2E0\uC744 \uCC98\uCE58\uD55C \uC0C1\uB300\uC5D0\uAC8C 1 \uD53C\uD574\uB97C \uC900\uB2E4. \uCC98\uCE58\uC790\uAC00 \uC5C6\uB294 \uC8FD\uC74C\uC5D0\uB294 \uBC1C\uB3D9\uD558\uC9C0 \uC54A\uB294\uB2E4."
    icon: {fileID: 0}
  - type: 10
    displayName: "\uD5C8\uC57D"
    description: "\uD134\uC774 \uC2DC\uC791\uB420 \uB54C\uB9C8\uB2E4 33% \uD655\uB960\uB85C \uC4F0\uB7EC\uC9C4\uB2E4. \uC591\uCABD \uD134 \uBAA8\uB450 \uD310\uC815\uD558\uBBC0\uB85C \uD55C \uBC14\uD034\uC5D0 \uB450 \uBC88 \uAD74\uB9B0\uB2E4. \uB300\uC2E0 \uD53C\uD574\uB85C\uB294 \uC8FD\uC9C0 \uC54A\uB294\uB2E4."
    icon: {fileID: 0}
  - type: 11
    displayName: "\uC800\uC8FC \uBA74\uC5ED"
    description: "\uC800\uC8FC\uB85C \uBC1B\uB294 \uD53C\uD574\uB97C \uC804\uBD80 \uBB34\uD6A8\uB85C \uD55C\uB2E4. \uD69F\uC218 \uC81C\uD55C\uC740 \uC5C6\uB2E4."
    icon: {fileID: 0}
  - type: 12
    displayName: "\uC9C4\uD654"
    description: ""
    icon: {fileID: 0}
  - type: 13
    displayName: "\uC804\uCCB4 \uCE58\uC720"
    description: "\uACF5\uACA9\uD560 \uB54C\uB9C8\uB2E4 10% \uD655\uB960\uB85C \uC0B4\uC544 \uC788\uB294 \uC544\uAD70 \uC804\uCCB4\uC758 \uCCB4\uB825\uC744 1 \uD68C\uBCF5\uC2DC\uD0A8\uB2E4."
    icon: {fileID: 0}
  - type: 14
    displayName: "\uD761\uD608"
    description: ""
    icon: {fileID: 0}
  - type: 15
    displayName: "\uCF54\uC2A4\uD2B8 \uD658\uAE09"
    description: "\uC0B4\uC544\uB0A8\uC740 \uD134\uB9C8\uB2E4 \uC18C\uD658 \uCF54\uC2A4\uD2B8\uB97C 1\uC529 \uBAA8\uC544 \uB450\uC5C8\uB2E4\uAC00 \uC4F0\uB7EC\uC9C8 \uB54C \uB3CC\uB824\uC900\uB2E4. \uCD5C\uB300 3\uAE4C\uC9C0 \uBAA8\uC778\uB2E4."
    icon: {fileID: 0}
  - type: 16
    displayName: "\uC720\uC5B8 \uAC15\uD654"
    description: "\uC774 \uAE30\uBB3C\uC758 \uC720\uC5B8\uC774 \uAC15\uD654\uB41C \uAC83\uC73C\uB85C \uCDE8\uAE09\uB41C\uB2E4. \uC2E4\uC81C \uD6A8\uACFC\uB294 \uAC01 \uC720\uC5B8\uC774 \uC815\uD55C\uB2E4."
    icon: {fileID: 0}
  - type: 17
    displayName: "\uD3EC\uC2DD"
    description: "\uC0AC\uB0E5\uAC10\uC744 \uC9C1\uC811 \uCC98\uCE58\uD558\uBA74 \uADF8 \uAE30\uBB3C \uB2A5\uB825\uCE58\uC758 3\uBD84\uC758 1\uC744 \uC790\uAE30 \uAC83\uC73C\uB85C \uAC00\uC838\uC628\uB2E4."
    icon: {fileID: 0}
  - type: 18
    displayName: "\uAE30\uC5B5 \uD3ED\uC8FC"
    description: "2\uD398\uC774\uC988\uC5D0 \uC5F4\uB9B0\uB2E4. \uCD1D \uACF5\uACA9\uB825\uC774 6 \uC624\uB97C \uB54C\uB9C8\uB2E4 \uD55C \uBC88\uC529, \uB2E4\uC74C \uACF5\uACA9\uC774 2\uC5F0\uD0C0\uAC00 \uB41C\uB2E4."
    icon: {fileID: 0}
  - type: 19
    displayName: "\uC0AC\uB0E5\uAC10 \uBB3C\uC0C9"
    description: "\uC0AC\uB0E5\uAC10\uC774 \uC5C6\uC73C\uBA74 \uC0C8\uB85C \uD558\uB098 \uC9C0\uC815\uD55C\uB2E4. \uC9C0\uC815\uB41C \uAE30\uBB3C\uC774 \uC0B4\uC544 \uC788\uB294 \uB3D9\uC548\uC5D0\uB294 \uD45C\uC801\uC774 \uBC14\uB00C\uC9C0 \uC54A\uB294\uB2E4."
    icon: {fileID: 0}
  - type: 20
    displayName: "\uC218\uD0C8"
    description: "\uACC4\uC57D\u00B7\uD76C\uC0DD\uC73C\uB85C \uC0C1\uB300\uAC00 \uC5BB\uC740 \uC774\uB4DD\uACFC \uC5EC\uC6B0\uC655\uC774 \uC9C1\uC811 \uCC98\uCE58\uD55C \uAE30\uBB3C\uC5D0\uC11C \uC218\uD0C8 \uC790\uC6D0\uACFC \uD0D0\uC695\uC744 \uAC70\uB454\uB2E4."
    icon: {fileID: 0}
  - type: 21
    displayName: "\uD0D0\uC695"
    description: "\uC218\uD0C8\uB85C \uBAA8\uC740 \uD0D0\uC695\uC774 \uC77C\uC815 \uC9C0\uC810\uC744 \uB118\uC744 \uB54C\uB9C8\uB2E4 \uD55C \uBC88\uC529 \uC5EC\uC6B0\uC655\uC774 \uAC15\uD574\uC9C4\uB2E4."
    icon: {fileID: 0}
  - type: 22
    displayName: "\uD22C\uC790"
    description: "\uD134\uB9C8\uB2E4 \uCF54\uC2A4\uD2B8\uB97C \uB4E4\uC5EC \uCCB4\uB825\uACFC \uACF5\uACA9\uB825\uC744 \uC62C\uB9B0\uB2E4. 2\uD398\uC774\uC988\uC5D0\uC11C\uB294 \uB4E4\uC774\uB294 \uAC12\uC774 \uC904\uACE0 \uC5BB\uB294 \uAC12\uC774 \uB298\uC5B4\uB09C\uB2E4."
    icon: {fileID: 0}
  - type: 23
    displayName: "\uC5EC\uC6B0\uC655 \uD398\uC774\uC988"
    description: "\uCCB4\uB825\uC774 12 \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uBA74 2\uD398\uC774\uC988\uB85C \uB118\uC5B4\uAC04\uB2E4."
    icon: {fileID: 0}
  - type: 24
    displayName: "\uC0C1\uC5B4\uC655 \uD398\uC774\uC988"
    description: "\uCCB4\uB825\uC774 20 \uC544\uB798\uB85C \uB0B4\uB824\uAC00\uBA74 2\uD398\uC774\uC988\uB85C \uB118\uC5B4\uAC04\uB2E4."
    icon: {fileID: 0}
  - type: 25
    displayName: "\uACE0\uC815"
    description: "\uC81C\uC790\uB9AC\uC5D0\uC11C \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uB294\uB2E4."
    icon: {fileID: 0}
  - type: 26
    displayName: "\uC0AC\uB0E5\uD130 \uAC1C\uC7A5"
    description: "\uC801 \uD134\uC5D0 \uC601\uC5ED\uC744 \uBBF8\uB9AC \uC608\uC57D\uD574 \uC54C\uB9AC\uACE0, \uB2E4\uC74C \uCC28\uB840\uC5D0 \uADF8 \uBC94\uC704\uC5D0 \uD53C\uD574\uB97C \uC900\uB2E4. \uC608\uC57D \uB4A4 \uB0A8\uC740 \uD589\uB3D9\uB825\uC73C\uB85C\uB294 \uD3C9\uBC94\uD558\uAC8C \uADFC\uC811 \uACF5\uACA9\uD55C\uB2E4."
    icon: {fileID: 0}
  - type: 27
    displayName: "\uC0C1\uC5B4\uC655 \uD3EC\uC2DD"
    description: "\uC601\uC5ED \uACF5\uACA9\uC5D0 \uB9DE\uC740 \uAE30\uBB3C\uC5D0 \uD45C\uC2DD\uC774 \uB0A8\uACE0, \uADF8 \uD45C\uC2DD\uC774 \uCD94\uAC00 \uD53C\uD574\uB85C \uC774\uC5B4\uC9C4\uB2E4."
    icon: {fileID: 0}
  - type: 28
    displayName: "\uB3CC\uC9C4"
    description: "\uC9C1\uC120\uC73C\uB85C \uB2EC\uB824 \uC55E\uC744 \uB9C9\uC740 \uAE30\uBB3C\uC744 \uB4E4\uC774\uBC1B\uACE0 \uBC00\uC5B4\uB0B8\uB2E4."
    icon: {fileID: 0}
  - type: 29
    displayName: "\uBD84\uB178\uC758 \uC5F0\uC1C4"
    description: "2\uD398\uC774\uC988\uC5D0 \uC5F4\uB9B0\uB2E4. \uB3CC\uC9C4\uC73C\uB85C \uC4F0\uB7EC\uC9C4 \uAE30\uBB3C\uC774 \uC790\uAE30 \uC720\uC5B8\uACFC \uBCC4\uAC1C\uB85C \uADF8 \uC790\uB9AC\uC5D0\uC11C \uD55C \uBC88 \uB354 \uD130\uC9C4\uB2E4."
    icon: {fileID: 0}
